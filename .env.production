# Vite applies this file (not .env) when running `vite build`, so a developer's
# local .env pointed at a dev backend (e.g. http://localhost:8000) can never leak
# into a deployed production bundle. Empty = relative /api calls, proxied to
# Cloud Run by Firebase Hosting rewrites (see firebase.json).
VITE_API_URL=

# Firebase client SDK config for production sign-in (public web API key — safe to
# commit, restricted by Firebase Auth/App Check, not a secret).
VITE_FIREBASE_API_KEY=AIzaSyBsVH7YW7YusP8HVNNzi6U1WTG2h_hJ8cY
VITE_FIREBASE_AUTH_DOMAIN=medreachai-679aa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medreachai-679aa
