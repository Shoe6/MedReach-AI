# Local dev: point directly at the FastAPI backend
VITE_API_URL=http://127.0.0.1:8010

# Auth always uses the live production project; Firestore can be emulated separately.
FIREBASE_PROJECT_ID=medreachai-679aa
USE_FIRESTORE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=medreachai-679aa
VITE_USE_AUTH_EMULATOR=false
# Required for Firebase Auth, including local development against this backend.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=medreachai-679aa.firebaseapp.com

# Production build: leave unset (or empty) so calls go through the
# relative /api/** path proxied by Firebase Hosting rewrites to Cloud Run.
# VITE_API_URL=
